PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cs418_module7
SESSION_SECRET=replace-with-a-new-random-secret
NODE_ENV=development
SERVE_CLIENT=false
TRUST_PROXY_HOPS=0

# Local practice may run without an external provider. Production requires true.
CAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAMES=localhost

# off, mock (local only), or live. No provider calls occur in mock mode.
AI_MODE=mock
# Create your key in Google AI Studio; keep it on the server.
GEMINI_API_KEY=
# Verify availability and quota in your own project before using live mode.
GEMINI_MODEL=gemini-3.5-flash-lite

# Email verification links use the browser origin (no /api suffix).
APP_ORIGIN=http://localhost:5173
# Use your own sender account and its Google App Password; see ../AUTH_SETUP.md.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=
